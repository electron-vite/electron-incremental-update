{
  "name": "electron-incremental-update",
  "version": "3.0.0-beta.5",
  "description": "Electron incremental update tools with Vite plugin, support bytecode protection",
  "keywords": [
    "bytecode",
    "electron",
    "incremental update",
    "updater"
  ],
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/electron-incremental-update.git"
  },
  "files": [
    "dist",
    "provider.d.ts",
    "provider.js",
    "utils.d.ts",
    "utils.js",
    "vite.d.ts",
    "vite.js"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "provider": [
        "./dist/provider.d.mts"
      ],
      "utils": [
        "./dist/utils.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./provider": {
      "import": "./dist/provider.mjs",
      "require": "./dist/provider.cjs"
    },
    "./utils": {
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.cjs"
    },
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "play": "vite",
    "play:build": "vite build",
    "release": "bun run format && bun run lint && bun run test && bun run build && bumpp --all",
    "test": "bun test --preload ./tests/setup.ts",
    "test:dev": "bun test --watch",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "qa": "oxlint --fix && oxfmt && tsc --noEmit"
  },
  "dependencies": {
    "@babel/plugin-transform-arrow-functions": "^7.27.1",
    "@babel/plugin-transform-template-literals": "^7.27.1",
    "ci-info": "^4.4.0",
    "local-pkg": "^1.1.2",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@subframe7536/type-utils": "^0.2.0",
    "@tsdown/css": "^0.21.4",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.11",
    "bumpp": "^10.4.1",
    "electron": "40.8.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  },
  "peerDependencies": {
    "@babel/core": "^7.29.0",
    "@electron/asar": "4.1.0"
  },
  "overrides": {
    "vite": "^8.0.0-beta.9"
  },
  "inlinedDependencies": {
    "@subframe7536/type-utils": "0.2.0"
  }
}
